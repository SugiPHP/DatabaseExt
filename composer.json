{
    "name": "sugiphp/database",
    "description": "Extends PHP's PDO/PDOStatement with PSR-14 event dispatching and a read/write connection state guard.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Clear\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Clear\\Database\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
